# ==============================================================================
# T2 Rental — Android Release Signing Configuration Example
# ==============================================================================
# DO NOT COMMIT android/key.properties or any keystore file (*.jks / *.keystore).
#
# To create your production release keystore, run:
#   keytool -genkey -v -keystore <path-to-keystore>/t2-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias t2_rental_key
#
# Then copy this file to "android/key.properties" and fill in your real details:
# ==============================================================================

storePassword=YOUR_STORE_PASSWORD_HERE
keyPassword=YOUR_KEY_PASSWORD_HERE
keyAlias=t2_rental_key
storeFile=../t2-release-key.jks

